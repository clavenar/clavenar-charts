    "failback": {
      "lossWindowSeconds": 20,
      "readinessSeconds": 148
    }
  },
  "failureModes": [
    {
      "id": "primary-host-loss",
      "behavior": "retain-outage",
      "failClosed": true,
      "recoveryAction": "externally fence the prior writer then restore the exact verified point"
    },
    {
      "id": "network-partition",
      "behavior": "refuse-promotion",
      "failClosed": true,
      "recoveryAction": "restore connectivity or prove infrastructure fencing before promotion"
    },
    {
      "id": "stale-recovery-point",
      "behavior": "reject-recovery-point",
      "failClosed": true,
      "recoveryAction": "create and verify a point within the accepted age ceiling"
    },
    {
      "id": "wrong-release-recovery-point",
      "behavior": "reject-recovery-point",
      "failClosed": true,
      "recoveryAction": "select a point bound to the exact immutable release"
    },
    {
      "id": "partial-or-substituted-recovery-point",
      "behavior": "reject-recovery-point",
      "failClosed": true,
      "recoveryAction": "reconstruct and verify every encrypted content addressed object"
    },
    {
      "id": "writer-fence-authority-loss",
      "behavior": "refuse-promotion",
      "failClosed": true,
      "recoveryAction": "restore separately custodied fence authority before writer transition"
    },
    {
      "id": "ledger-process-loss",
      "behavior": "service-unavailable",
      "failClosed": true,
      "recoveryAction": "restart one ledger against its retained verified store"
    },
    {
      "id": "ledger-sqlite-store-loss",
      "behavior": "dependent-readiness-unavailable",
      "failClosed": true,
      "recoveryAction": "restore ledger evidence from the selected complete recovery point"
    },
    {
      "id": "postgres-loss",
      "behavior": "service-unavailable",
      "failClosed": true,
      "recoveryAction": "restore the external database then restart the staged single ledger"
    },
    {
      "id": "identity-loss",
      "behavior": "dependent-readiness-unavailable",
      "failClosed": true,
      "recoveryAction": "restore identity authority and verify issuer continuity"
    },
    {
      "id": "hil-loss",
      "behavior": "governed-execution-unavailable",
      "failClosed": true,
      "recoveryAction": "restore decisions and approval authority before reviewed execution"
    },
    {
      "id": "policy-loss",
      "behavior": "governed-execution-unavailable",
      "failClosed": true,
      "recoveryAction": "restore governance state before policy evaluated execution"
    },
    {
      "id": "proxy-execution-state-loss",
      "behavior": "governed-execution-unavailable",
      "failClosed": true,
      "recoveryAction": "restore durable execution state before accepting governed calls"
    },
    {
      "id": "nats-jetstream-loss",
      "behavior": "durable-delivery-unavailable",
      "failClosed": true,
      "recoveryAction": "restore streams consumers and key value sequences before readiness"
    },
    {
      "id": "vault-loss",
      "behavior": "credential-issuance-unavailable",
      "failClosed": true,
      "recoveryAction": "restore vault storage and separately custodied recovery material"
    },
    {
      "id": "workload-identity-loss",
      "behavior": "reissue-required",
      "failClosed": true,
      "recoveryAction": "use signed one use recovery and reissue without copying private leaves"
    },
    {
      "id": "operator-custody-loss",
      "behavior": "recovery-blocked",
      "failClosed": true,
      "recoveryAction": "restore separately held operator custody through its external procedure"
    }
  ],
