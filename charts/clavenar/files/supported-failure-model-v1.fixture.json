{
  "schemaVersion": 1,
  "contract": "clavenar.supported-failure-model/v1",
  "status": "supported-recovery-with-unmet-critical-rpo",
  "topologies": [
    {
      "id": "compose-cold-active-passive",
      "supportLevel": "tested-manual-cold-recovery",
      "writerCount": 1,
      "promotion": "external-fence-then-manual",
      "stateCoverage": "all-20-scheduled-backup-partitions",
      "failClosedCondition": "writer-not-fenced-or-point-not-exact-and-verified",
      "recoveryAction": "restore-exact-release-from-verified-encrypted-point"
    },
    {
      "id": "helm-single-writer",
      "supportLevel": "supported-single-writer-deployment",
      "writerCount": 1,
      "promotion": "operator-managed-no-automatic-failover",
      "stateCoverage": "all-20-with-operator-supplied-durability",
      "failClosedCondition": "required-state-or-external-durability-unavailable",
      "recoveryAction": "operator-restores-single-writer-and-dependencies"
    },
    {
      "id": "staged-postgres-ledger",
      "supportLevel": "staged-ledger-path-only",
      "writerCount": 1,
      "promotion": "none",
      "stateCoverage": "ledger-evidence-only",
      "failClosedCondition": "postgres-or-supported-ledger-path-unavailable",
      "recoveryAction": "restore-external-postgres-and-restart-one-ledger"
    }
  ],
  "objectives": {
    "criticalStateRpoObjectiveSeconds": 300,
