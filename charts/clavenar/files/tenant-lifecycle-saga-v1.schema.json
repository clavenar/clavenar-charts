{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.clavenar.com/contracts/tenant-lifecycle-saga-v1.schema.json",
  "title": "Clavenar durable tenant lifecycle saga",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "coordinator",
    "authority",
    "idempotency",
    "operationStates",
    "stepStates",
    "journaling",
    "retry",
    "plans",
    "receipt",
    "sourceChecks",
    "prohibitions"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contract": {"const": "clavenar.tenant-lifecycle-saga/v1"},
    "coordinator": {"const": "identity"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant", "caller", "requestTenantAuthority"],
      "properties": {
        "tenant": {"const": "verified-operator-session-and-path-match"},
        "caller": {"const": "workload-mtls-plus-tenant-lifecycle-capability"},
        "requestTenantAuthority": {"const": "none"}
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keySource",
        "scope",
        "requestDigest",
        "intentMutable",
        "mismatchStatus",
        "activePerTenant"
      ],
      "properties": {
        "keySource": {"const": "Idempotency-Key"},
        "scope": {"const": "tenant-kind-key"},
        "requestDigest": {"const": "sha256-canonical-intent"},
        "intentMutable": {"const": false},
        "mismatchStatus": {"const": 409},
        "activePerTenant": {"const": 1}
      }
    },
    "operationStates": {
      "type": "array",
      "prefixItems": [
        {"const": "pending"},
        {"const": "running"},
        {"const": "waiting_retry"},
        {"const": "manual_recovery"},
        {"const": "compensating"},
        {"const": "compensated"},
        {"const": "succeeded"}
      ],
      "items": false,
      "minItems": 7,
      "maxItems": 7
    },
    "stepStates": {
      "type": "array",
      "prefixItems": [
        {"const": "pending"},
        {"const": "running"},
        {"const": "retryable"},
        {"const": "manual_recovery"},
        {"const": "compensating"},
        {"const": "compensated"},
        {"const": "skipped"},
        {"const": "succeeded"}
      ],
      "items": false,
      "minItems": 8,
      "maxItems": 8
    },
    "journaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeEffect", "afterEffect", "leaseExpiry", "errorStorage"],
      "properties": {
        "beforeEffect": {"const": "durable-running-with-attempt-and-lease"},
        "afterEffect": {"const": "durable-owner-receipt-or-sanitized-error"},
        "leaseExpiry": {"const": "retry-same-idempotent-effect"},
        "errorStorage": {"const": "sanitized-bounded"}
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAttempts",
        "backoffSeconds",
        "lostResponse",
        "exhaustion"
      ],
      "properties": {
        "maxAttempts": {"const": 5},
        "backoffSeconds": {
          "type": "array",
          "prefixItems": [
            {"const": 1},
            {"const": 2},
            {"const": 4},
            {"const": 8},
            {"const": 16}
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        "lostResponse": {"const": "reconcile-owner-or-repeat-idempotently"},
        "exhaustion": {"const": "manual_recovery"}
      }
    },
    "plans": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/provisionPlan"},
        {"$ref": "#/$defs/offboardPlan"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantScoped",
        "includesEveryStep",
        "successSource",
        "crossTenantStatus"
      ],
      "properties": {
        "tenantScoped": {"const": true},
        "includesEveryStep": {"const": true},
        "successSource": {"const": "coordinator-terminal-state-only"},
        "crossTenantStatus": {"const": 404}
      }
    },
    "sourceChecks": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/$defs/sourceCheck"}
    },
    "prohibitions": {
      "type": "array",
      "prefixItems": [
        {"const": "success-before-terminal-receipt"},
        {"const": "ignored-owner-failure"},
        {"const": "mutable-idempotency-intent"},
        {"const": "two-active-operations-per-tenant"},
        {"const": "effect-before-running-journal"},
        {"const": "unbounded-retry"},
        {"const": "cross-tenant-operation-disclosure"},
        {"const": "implicit-destructive-compensation"},
        {"const": "offboard-before-authority-fence"}
      ],
      "items": false,
      "minItems": 9,
      "maxItems": 9
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "owner", "effect", "compensation"],
      "properties": {
        "id": {
          "enum": [
            "tenant_record",
            "credential_keys",
            "authority_fence",
            "cache_generation",
            "policy_namespace",
            "hil_namespace",
            "ledger_lifecycle_marker",
            "ledger_final_export",
            "ledger_tombstone",
            "retained_backup_disposition"
          ]
        },
        "order": {"type": "integer", "minimum": 1, "maximum": 8},
        "owner": {
          "enum": ["identity", "proxy", "policy-engine", "hil", "ledger", "platform"]
        },
        "effect": {"type": "string", "minLength": 1, "maxLength": 96},
        "compensation": {
          "enum": ["idempotent-reverse", "not-required", "manual-recovery-only"]
        }
      }
    },
    "provisionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "steps"],
      "properties": {
        "kind": {"const": "provision"},
        "steps": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                {"$ref": "#/$defs/step"},
                {"properties": {"id": {"const": "tenant_record"}, "order": {"const": 1}, "owner": {"const": "identity"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/step"},
                {"properties": {"id": {"const": "credential_keys"}, "order": {"const": 2}, "owner": {"const": "identity"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/step"},
                {"properties": {"id": {"const": "policy_namespace"}, "order": {"const": 3}, "owner": {"const": "policy-engine"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/step"},
                {"properties": {"id": {"const": "hil_namespace"}, "order": {"const": 4}, "owner": {"const": "hil"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/step"},
                {"properties": {"id": {"const": "cache_generation"}, "order": {"const": 5}, "owner": {"const": "proxy"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/step"},
                {"properties": {"id": {"const": "ledger_lifecycle_marker"}, "order": {"const": 6}, "owner": {"const": "ledger"}}}
              ]
            }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        }
      }
    },
    "offboardPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "steps"],
      "properties": {
        "kind": {"const": "offboard"},
        "steps": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                {"$ref": "#/$defs/step"},
                {"properties": {"id": {"const": "authority_fence"}, "order": {"const": 1}, "owner": {"const": "identity"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/step"},
                {"properties": {"id": {"const": "credential_keys"}, "order": {"const": 2}, "owner": {"const": "identity"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/step"},
                {"properties": {"id": {"const": "cache_generation"}, "order": {"const": 3}, "owner": {"const": "proxy"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/step"},
                {"properties": {"id": {"const": "policy_namespace"}, "order": {"const": 4}, "owner": {"const": "policy-engine"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/step"},
                {"properties": {"id": {"const": "hil_namespace"}, "order": {"const": 5}, "owner": {"const": "hil"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/step"},
                {"properties": {"id": {"const": "ledger_final_export"}, "order": {"const": 6}, "owner": {"const": "ledger"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/step"},
                {"properties": {"id": {"const": "ledger_tombstone"}, "order": {"const": 7}, "owner": {"const": "ledger"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/step"},
                {"properties": {"id": {"const": "retained_backup_disposition"}, "order": {"const": 8}, "owner": {"const": "platform"}}}
              ]
            }
          ],
          "items": false,
          "minItems": 8,
          "maxItems": 8
        }
      }
    },
    "sourceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "contains"],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^clavenar-[a-z0-9-]+/.+"
        },
        "contains": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
