{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.clavenar.com/contracts/tenant-route-authorization-v1.schema.json",
  "title": "Clavenar tenant route authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "productionIdentity",
    "authority",
    "routes",
    "denial",
    "compatibility",
    "sourceChecks",
    "prohibitions"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contract": {"const": "clavenar.tenant-route-authorization/v1"},
    "productionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "required", "acceptedShapes", "rejected"],
      "properties": {
        "source": {"const": "verified-client-certificate-uri-san"},
        "required": {"const": true},
        "acceptedShapes": {
          "type": "array",
          "prefixItems": [
            {"const": "spiffe://<trust-domain>/tenant/<tenant>/agent/<agent>"},
            {"const": "spiffe://<trust-domain>/tenant/<tenant>/agent/<agent>/instance/<instance>"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "rejected": {
          "type": "array",
          "prefixItems": [
            {"const": "absent-spiffe-uri-san"},
            {"const": "legacy-common-name"},
            {"const": "abbreviated-agent-spiffe"},
            {"const": "non-agent-spiffe"},
            {"const": "malformed-or-extra-path"}
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proxy", "hil", "lite"],
      "properties": {
        "proxy": {"const": "verified-tenant-agent-spiffe"},
        "hil": {"const": "authenticated-principal-or-exact-workload-scope"},
        "lite": {"const": "tenant-bound-agent-or-operator-token"}
      }
    },
    "routes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/routeOwner"}
    },
    "denial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timing", "objectStatus", "mutation", "collection"],
      "properties": {
        "timing": {"const": "before-target-lookup-or-mutation"},
        "objectStatus": {"const": "cross-tenant-equals-not-found"},
        "mutation": {"const": "none"},
        "collection": {"const": "authenticated-tenant-only"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "development"],
      "properties": {
        "production": {"const": "no-unqualified-identity"},
        "development": {"const": "explicit-single-user-legacy-only"}
      }
    },
    "sourceChecks": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/sourceCheck"}
    },
    "prohibitions": {
      "type": "array",
      "prefixItems": [
        {"const": "header-body-or-query-tenant-authority"},
        {"const": "production-common-name-fallback"},
        {"const": "unqualified-multi-agent-registry"},
        {"const": "global-authenticated-pending-list"},
        {"const": "cross-tenant-existence-disclosure"},
        {"const": "cross-tenant-decision-mutation"}
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    }
  },
  "$defs": {
    "routeOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "routes"],
      "properties": {
        "owner": {"enum": ["proxy", "hil", "lite"]},
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["ingress", "list", "stream", "decide", "poll", "get-by-id"]
          },
          "uniqueItems": true
        }
      }
    },
    "sourceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "contains"],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^clavenar-[a-z0-9-]+/.+"
        },
        "contains": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
