{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.clavenar.com/contracts/state-namespace-isolation-v1.schema.json",
  "title": "Clavenar state namespace isolation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "namespaces",
    "allocation",
    "cleanup",
    "ledger",
    "components",
    "prohibitions"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contract": {"const": "clavenar.state-namespace-isolation/v1"},
    "namespaces": {
      "type": "array",
      "prefixItems": [
        {"const": "operator"},
        {"const": "demo"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "strategy", "collisionVector", "expected"],
      "properties": {
        "scope": {"const": "shared-global"},
        "strategy": {"const": "cryptographically-random-uuid"},
        "collisionVector": {"const": "same-tenant-same-agent-cross-namespace"},
        "expected": {"const": "distinct-identifiers-and-owned-state"}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "authentication",
        "selection",
        "idempotent",
        "volumeAction",
        "operatorRetention",
        "legacyRetention",
        "receiptContract"
      ],
      "properties": {
        "namespace": {"const": "demo"},
        "authentication": {"const": "workload-mtls-capability"},
        "selection": {"const": "explicit-owner-only"},
        "idempotent": {"const": true},
        "volumeAction": {"const": "retain"},
        "operatorRetention": {"const": "required"},
        "legacyRetention": {"const": "required"},
        "receiptContract": {"const": "clavenar.namespace-cleanup-receipt/v1"}
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainVersion",
        "namespacePosition",
        "cleanupMutation",
        "liveViews",
        "verification",
        "exports",
        "anchors"
      ],
      "properties": {
        "chainVersion": {"const": 6},
        "namespacePosition": {"const": "after-v5-fields"},
        "cleanupMutation": {"const": "separate-non-hash-tombstone"},
        "liveViews": {"const": "exclude-demo-tombstones"},
        "verification": {"const": "retain-all-chain-rows"},
        "exports": {"const": "retain-evidence"},
        "anchors": {"const": "retain"}
      }
    },
    "components": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/component"}
    },
    "prohibitions": {
      "type": "array",
      "prefixItems": [
        {"const": "untrusted-namespace-selection"},
        {"const": "implicit-demo-default"},
        {"const": "operator-or-legacy-cleanup"},
        {"const": "ledger-chain-row-deletion"},
        {"const": "forensic-evidence-deletion"},
        {"const": "service-stop-for-cleanup"},
        {"const": "volume-delete-or-recreate"},
        {"const": "allocator-reset"}
      ],
      "items": false,
      "minItems": 8,
      "maxItems": 8
    }
  },
  "$defs": {
    "sourceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "contains"],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^clavenar-[a-z0-9-]+/.+"
        },
        "contains": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "ownership", "cleanup", "sourceChecks"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "owner": {
          "type": "string",
          "enum": ["e2e", "hil", "ledger", "proxy", "shared"]
        },
        "ownership": {
          "type": "string",
          "enum": [
            "explicit-required",
            "hash-committed",
            "trusted-derived",
            "typed-exact"
          ]
        },
        "cleanup": {
          "type": "string",
          "enum": [
            "authenticated-owned-delete",
            "authenticated-owned-tombstone",
            "not-applicable",
            "orchestrates-owned-endpoints"
          ]
        },
        "sourceChecks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceCheck"}
        }
      }
    }
  }
}
