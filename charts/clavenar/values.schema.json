{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Clavenar Helm values",
  "type": "object",
  "properties": {
    "services": {
      "type": "object",
      "properties": {
        "console": {
          "type": "object",
          "required": [
            "enabled",
            "port",
            "demoPort",
            "diagnosticsPort",
            "operatorMtls",
            "mutationOrigins",
            "demo",
            "probes",
            "metrics",
            "extraEnv"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "const": 8085 },
            "demoPort": { "type": "integer", "const": 9085 },
            "diagnosticsPort": { "type": "integer", "const": 9185 },
            "operatorMtls": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "publicTrustSecretName"],
              "properties": {
                "enabled": { "type": "boolean" },
                "publicTrustSecretName": { "type": "string" }
              }
            },
            "mutationOrigins": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$"
              }
            },
            "demo": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "probes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "health", "ready", "port"],
              "properties": {
                "type": { "const": "httpGet" },
                "health": { "const": "/health" },
                "ready": { "const": "/readyz" },
                "port": { "type": "integer", "const": 9185 }
              }
            },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "port", "path"],
              "properties": {
                "enabled": { "const": true },
                "port": { "type": "integer", "const": 9185 },
                "path": { "const": "/metrics" }
              }
            },
            "extraEnv": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "not": {
                      "enum": [
                        "CLAVENAR_CONSOLE_AUTH",
                        "CLAVENAR_CONSOLE_BIND",
                        "CLAVENAR_CONSOLE_PORT",
                        "CLAVENAR_CONSOLE_DEMO_ADDR",
                        "CLAVENAR_CONSOLE_DIAGNOSTICS_ADDR",
                        "CLAVENAR_CONSOLE_OPERATOR_TLS_CERT_PATH",
                        "CLAVENAR_CONSOLE_OPERATOR_TLS_KEY_PATH",
                        "CLAVENAR_CONSOLE_OPERATOR_CLIENT_CA_PATH",
                        "CLAVENAR_CONSOLE_OPERATOR_IDENTITIES_PATH",
                        "CLAVENAR_CONSOLE_AUTH_RATE_LIMIT_MAX",
                        "CLAVENAR_CONSOLE_AUTH_RATE_LIMIT_WINDOW_SECS",
                        "CLAVENAR_CONSOLE_RELEASE_VERSION",
                        "CLAVENAR_CONSOLE_MUTATION_ORIGINS",
                        "CLAVENAR_HIL_DECIDE_TOKEN",
                        "CLAVENAR_CONSOLE_ALLOW_DISABLED_NETWORK"
                      ]
                    }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "operatorMtls": {
                    "properties": { "enabled": { "const": true } },
                    "required": ["enabled"]
                  }
                },
                "required": ["operatorMtls"]
              },
              "then": {
                "properties": {
                  "operatorMtls": {
                    "properties": {
                      "publicTrustSecretName": { "minLength": 1 }
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "operatorMtls": {
                    "properties": {
                      "publicTrustSecretName": { "const": "" }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "demo": {
                    "properties": { "enabled": { "const": true } },
                    "required": ["enabled"]
                  }
                },
                "required": ["demo"]
              },
              "then": {
                "properties": {
                  "operatorMtls": {
                    "properties": { "enabled": { "const": true } }
                  }
                }
              }
            }
          ]
        },
        "assurance": {
          "type": "object",
          "required": [
            "enabled",
            "port",
            "healthPort",
            "serviceType",
            "probes",
            "metrics",
            "forensicSubject",
            "forensicStream",
            "requestTimeoutSecs",
            "runTimeoutSecs",
            "publishTimeoutSecs",
            "extraEnv"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "const": 8088 },
            "healthPort": { "type": "integer", "const": 9088 },
            "serviceType": { "const": "ClusterIP" },
            "probes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "health", "ready", "port"],
              "properties": {
                "type": { "const": "httpGet" },
                "health": { "const": "/health" },
                "ready": { "const": "/readyz" },
                "port": { "type": "integer", "const": 9088 }
              }
            },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": { "const": false }
              }
            },
            "forensicSubject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\s.*>]+(\\.[^\\s.*>]+)*$"
            },
            "forensicStream": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "requestTimeoutSecs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "runTimeoutSecs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "publishTimeoutSecs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "extraEnv": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "not": {
                      "enum": [
                        "CLAVENAR_ASSURANCE_ADMIN_PORT",
                        "CLAVENAR_ASSURANCE_DIAGNOSTICS_PORT",
                        "CLAVENAR_ASSURANCE_TLS_DIR",
                        "CLAVENAR_ASSURANCE_ALLOWED_CALLERS",
                        "CLAVENAR_ASSURANCE_FORENSIC_SUBJECT",
                        "CLAVENAR_ASSURANCE_FORENSIC_STREAM",
                        "CLAVENAR_ASSURANCE_REQUEST_TIMEOUT_SECS",
                        "CLAVENAR_ASSURANCE_RUN_TIMEOUT_SECS",
                        "CLAVENAR_ASSURANCE_PUBLISH_TIMEOUT_SECS"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "tlsBundle": {
      "type": "object",
      "properties": {
        "secretName": { "type": "string" },
        "mountPath": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "console": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operatorMtls", "demo"],
          "properties": {
            "operatorMtls": { "$ref": "#/definitions/consolePeerClass" },
            "demo": { "$ref": "#/definitions/consolePeerClass" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "services": {
            "properties": {
              "console": {
                "properties": {
                  "operatorMtls": {
                    "properties": { "enabled": { "const": true } },
                    "required": ["enabled"]
                  }
                },
                "required": ["operatorMtls"]
              }
            },
            "required": ["console"]
          }
        },
        "required": ["services"]
      },
      "then": {
        "properties": {
          "tlsBundle": {
            "properties": {
              "secretName": { "type": "string", "minLength": 1 },
              "mountPath": { "const": "/certs" }
            },
            "required": ["secretName", "mountPath"]
          }
        },
        "required": ["tlsBundle"]
      }
    }
  ],
  "definitions": {
    "consolePeerClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedPeers"],
      "properties": {
        "allowedPeers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["podSelector"],
            "properties": {
              "podSelector": { "$ref": "#/definitions/exactPositiveSelector" },
              "namespaceSelector": { "$ref": "#/definitions/exactPositiveSelector" }
            }
          }
        }
      }
    },
    "exactPositiveSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matchLabels"],
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
