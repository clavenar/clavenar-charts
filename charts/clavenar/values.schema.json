{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Clavenar Helm values",
  "type": "object",
  "required": ["deploymentProfile"],
  "properties": {
    "deploymentProfile": {
      "type": "string",
      "enum": ["evaluation", "production"]
    },
    "authSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecretName", "rotationId"],
      "properties": {
        "existingSecretName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "rotationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      }
    },
    "services": {
      "type": "object",
      "properties": {
        "proxy": {
          "type": "object",
          "properties": {
            "grantJwksRefreshSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "grantJwksMaxStalenessSeconds": {
              "type": "integer",
              "minimum": 2,
              "maximum": 900
            },
            "grantJwksFetchTimeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "extraEnv": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "not": {
                      "enum": [
                        "NATS_URL",
                        "CLAVENAR_GRACEFUL_DRAIN_SECS",
                        "CLAVENAR_PROXY_HEALTH_ADDR",
                        "CLAVENAR_BRAIN_URL",
                        "CLAVENAR_POLICY_URL",
                        "CLAVENAR_HIL_URL",
                        "CLAVENAR_IDENTITY_URL",
                        "CLAVENAR_PROXY_GRANT_JWKS_URL",
                        "CLAVENAR_PROXY_GRANT_JWKS_REFRESH_SECS",
                        "CLAVENAR_PROXY_GRANT_JWKS_MAX_STALENESS_SECS",
                        "CLAVENAR_PROXY_GRANT_JWKS_FETCH_TIMEOUT_SECS",
                        "CLAVENAR_PROXY_OUTBOUND_CERT_PATH",
                        "CLAVENAR_PROXY_OUTBOUND_KEY_PATH",
                        "CLAVENAR_PROXY_OUTBOUND_CA_PATH",
                        "NATS_TLS_CERT_PATH",
                        "NATS_TLS_KEY_PATH",
                        "NATS_TLS_CA_PATH",
                        "VAULT_ADDR",
                        "VAULT_TOKEN"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "policyEngine": {
          "type": "object",
          "properties": {
            "extraEnv": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "not": {
                      "enum": [
                        "NATS_URL",
                        "CLAVENAR_GRACEFUL_DRAIN_SECS",
                        "CLAVENAR_POLICY_ENGINE_BRAIN_URL",
                        "CLAVENAR_POLICY_EXPECTED_PEER_SPIFFE",
                        "CLAVENAR_POLICY_TLS_DIR",
                        "CLAVENAR_POLICY_ALLOWED_CALLERS",
                        "CLAVENAR_POLICY_HEALTH_ADDR",
                        "NATS_TLS_CERT_PATH",
                        "NATS_TLS_KEY_PATH",
                        "NATS_TLS_CA_PATH"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "hil": {
          "type": "object",
          "properties": {
            "extraEnv": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "not": {
                      "enum": [
                        "NATS_URL",
                        "CLAVENAR_GRACEFUL_DRAIN_SECS",
                        "CLAVENAR_HIL_TLS_DIR",
                        "CLAVENAR_HIL_ALLOWED_CALLERS",
                        "CLAVENAR_HIL_HEALTH_ADDR",
                        "CLAVENAR_HIL_DECIDE_TOKEN",
                        "CLAVENAR_HIL_SESSION_KEY",
                        "NATS_TLS_CERT_PATH",
                        "NATS_TLS_KEY_PATH",
                        "NATS_TLS_CA_PATH"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "identity": {
          "type": "object",
          "properties": {
            "extraEnv": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "not": {
                      "enum": [
                        "NATS_URL",
                        "CLAVENAR_GRACEFUL_DRAIN_SECS",
                        "CLAVENAR_IDENTITY_TLS_DIR",
                        "CLAVENAR_IDENTITY_ALLOWED_CALLERS",
                        "CLAVENAR_IDENTITY_MTLS_ADDR",
                        "CLAVENAR_IDENTITY_CA_DIR",
                        "NATS_TLS_CERT_PATH",
                        "NATS_TLS_KEY_PATH",
                        "NATS_TLS_CA_PATH",
                        "VAULT_ADDR",
                        "VAULT_TOKEN"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "deepReview": {
          "type": "object",
          "properties": {
            "extraEnv": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "not": {
                      "enum": [
                        "NATS_URL",
                        "CLAVENAR_GRACEFUL_DRAIN_SECS",
                        "CLAVENAR_DEEP_REVIEW_LEDGER_URL",
                        "CLAVENAR_DEEP_REVIEW_NATS_URL",
                        "NATS_TLS_CERT_PATH",
                        "NATS_TLS_KEY_PATH",
                        "NATS_TLS_CA_PATH"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "ledger": {
          "type": "object",
          "required": [
            "enabled",
            "port",
            "mtlsPort",
            "trustedProxySpiffe",
            "requireTrustedProxy",
            "extraEnv"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "const": 8083 },
            "mtlsPort": { "type": "integer", "const": 8183 },
            "trustedProxySpiffe": {
              "type": "string",
              "enum": ["", "spiffe://clavenar.local/service/website"]
            },
            "requireTrustedProxy": { "type": "boolean" },
            "extraEnv": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "not": {
                      "enum": [
                        "NATS_URL",
                        "CLAVENAR_GRACEFUL_DRAIN_SECS",
                        "CLAVENAR_LEDGER_ALLOWED_CALLERS",
                        "CLAVENAR_LEDGER_TLS_DIR",
                        "CLAVENAR_LEDGER_MTLS_ADDR",
                        "CLAVENAR_LEDGER_TRUSTED_PROXY_SPIFFE",
                        "CLAVENAR_LEDGER_REQUIRE_TRUSTED_PROXY",
                        "NATS_TLS_CERT_PATH",
                        "NATS_TLS_KEY_PATH",
                        "NATS_TLS_CA_PATH"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "brain": {
          "type": "object",
          "required": [
            "enabled",
            "port",
            "healthPort",
            "serviceType",
            "explainCallerSpiffe",
            "narrateCallerSpiffe",
            "explainRateLimitPerMinute",
            "narrateRateLimitPerMinute",
            "auxSpendBudgetMicroUsdPerHour",
            "auxTimeoutMillis",
            "auxBodyLimitBytes",
            "extraEnv"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "const": 8081 },
            "healthPort": { "type": "integer", "const": 9081 },
            "serviceType": { "const": "ClusterIP" },
            "explainCallerSpiffe": {
              "const": "spiffe://clavenar.local/service/policy-engine"
            },
            "narrateCallerSpiffe": {
              "const": "spiffe://clavenar.local/service/console"
            },
            "explainRateLimitPerMinute": {
              "type": "integer",
              "minimum": 1
            },
            "narrateRateLimitPerMinute": {
              "type": "integer",
              "minimum": 1
            },
            "auxSpendBudgetMicroUsdPerHour": {
              "type": "integer",
              "minimum": 1
            },
            "auxTimeoutMillis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30000
            },
            "auxBodyLimitBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "extraEnv": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "not": {
                      "enum": [
                        "NATS_URL",
                        "CLAVENAR_GRACEFUL_DRAIN_SECS",
                        "CLAVENAR_BRAIN_TLS_DIR",
                        "CLAVENAR_BRAIN_ALLOWED_CALLERS",
                        "CLAVENAR_BRAIN_HEALTH_ADDR",
                        "CLAVENAR_BRAIN_PLAIN_ADDR",
                        "CLAVENAR_BRAIN_REQUIRE_AUX_CONTROLS",
                        "CLAVENAR_BRAIN_EXPLAIN_CALLER_SPIFFE",
                        "CLAVENAR_BRAIN_NARRATE_CALLER_SPIFFE",
                        "CLAVENAR_BRAIN_EXPLAIN_RATE_LIMIT_PER_MINUTE",
                        "CLAVENAR_BRAIN_NARRATE_RATE_LIMIT_PER_MINUTE",
                        "CLAVENAR_BRAIN_AUX_SPEND_BUDGET_MICRO_USD_PER_HOUR",
                        "CLAVENAR_BRAIN_AUX_TIMEOUT_MILLIS",
                        "CLAVENAR_BRAIN_AUX_BODY_LIMIT_BYTES"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "console": {
          "type": "object",
          "required": [
            "enabled",
            "port",
            "demoPort",
            "diagnosticsPort",
            "operatorMtls",
            "mutationOrigins",
            "demo",
            "probes",
            "metrics",
            "extraEnv"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "const": 8085 },
            "demoPort": { "type": "integer", "const": 9085 },
            "diagnosticsPort": { "type": "integer", "const": 9185 },
            "operatorMtls": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "publicTrustSecretName"],
              "properties": {
                "enabled": { "type": "boolean" },
                "publicTrustSecretName": { "type": "string" }
              }
            },
            "mutationOrigins": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$"
              }
            },
            "demo": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "probes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "health", "ready", "port"],
              "properties": {
                "type": { "const": "httpGet" },
                "health": { "const": "/health" },
                "ready": { "const": "/readyz" },
                "port": { "type": "integer", "const": 9185 }
              }
            },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "port", "path"],
              "properties": {
                "enabled": { "const": true },
                "port": { "type": "integer", "const": 9185 },
                "path": { "const": "/metrics" }
              }
            },
            "extraEnv": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "not": {
                      "enum": [
                        "NATS_URL",
                        "CLAVENAR_GRACEFUL_DRAIN_SECS",
                        "CLAVENAR_CONSOLE_AUTH",
                        "CLAVENAR_CONSOLE_BIND",
                        "CLAVENAR_CONSOLE_PORT",
                        "CLAVENAR_CONSOLE_DEMO_ADDR",
                        "CLAVENAR_CONSOLE_DIAGNOSTICS_ADDR",
                        "CLAVENAR_CONSOLE_OPERATOR_TLS_CERT_PATH",
                        "CLAVENAR_CONSOLE_OPERATOR_TLS_KEY_PATH",
                        "CLAVENAR_CONSOLE_OPERATOR_CLIENT_CA_PATH",
                        "CLAVENAR_CONSOLE_OPERATOR_IDENTITIES_PATH",
                        "CLAVENAR_CONSOLE_AUTH_RATE_LIMIT_MAX",
                        "CLAVENAR_CONSOLE_AUTH_RATE_LIMIT_WINDOW_SECS",
                        "CLAVENAR_CONSOLE_RELEASE_VERSION",
                        "CLAVENAR_CONSOLE_MUTATION_ORIGINS",
                        "CLAVENAR_CONSOLE_BRAIN_URL",
                        "CLAVENAR_CONSOLE_LEDGER_URL",
                        "CLAVENAR_CONSOLE_HIL_URL",
                        "CLAVENAR_CONSOLE_POLICY_ENGINE_URL",
                        "CLAVENAR_CONSOLE_IDENTITY_URL",
                        "CLAVENAR_ASSURANCE_URL",
                        "CLAVENAR_CONSOLE_TLS_DIR",
                        "CLAVENAR_CONSOLE_OUTBOUND_CERT_PATH",
                        "CLAVENAR_CONSOLE_OUTBOUND_KEY_PATH",
                        "CLAVENAR_CONSOLE_OUTBOUND_CA_PATH",
                        "CLAVENAR_HIL_DECIDE_TOKEN",
                        "CLAVENAR_CONSOLE_ALLOW_DISABLED_NETWORK"
                      ]
                    }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "operatorMtls": {
                    "properties": { "enabled": { "const": true } },
                    "required": ["enabled"]
                  }
                },
                "required": ["operatorMtls"]
              },
              "then": {
                "properties": {
                  "operatorMtls": {
                    "properties": {
                      "publicTrustSecretName": { "minLength": 1 }
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "operatorMtls": {
                    "properties": {
                      "publicTrustSecretName": { "const": "" }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "demo": {
                    "properties": { "enabled": { "const": true } },
                    "required": ["enabled"]
                  }
                },
                "required": ["demo"]
              },
              "then": {
                "properties": {
                  "operatorMtls": {
                    "properties": { "enabled": { "const": true } }
                  }
                }
              }
            }
          ]
        },
        "assurance": {
          "type": "object",
          "required": [
            "enabled",
            "port",
            "healthPort",
            "serviceType",
            "probes",
            "metrics",
            "forensicSubject",
            "forensicStream",
            "requestTimeoutSecs",
            "runTimeoutSecs",
            "publishTimeoutSecs",
            "extraEnv"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "const": 8088 },
            "healthPort": { "type": "integer", "const": 9088 },
            "serviceType": { "const": "ClusterIP" },
            "probes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "health", "ready", "port"],
              "properties": {
                "type": { "const": "httpGet" },
                "health": { "const": "/health" },
                "ready": { "const": "/readyz" },
                "port": { "type": "integer", "const": 9088 }
              }
            },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": { "const": false }
              }
            },
            "forensicSubject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\s.*>]+(\\.[^\\s.*>]+)*$"
            },
            "forensicStream": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "requestTimeoutSecs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "runTimeoutSecs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "publishTimeoutSecs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "extraEnv": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "not": {
                      "enum": [
                        "NATS_URL",
                        "CLAVENAR_GRACEFUL_DRAIN_SECS",
                        "CLAVENAR_ASSURANCE_PROXY_URL",
                        "CLAVENAR_ASSURANCE_NATS_URL",
                        "CLAVENAR_ASSURANCE_ADMIN_PORT",
                        "CLAVENAR_ASSURANCE_DIAGNOSTICS_PORT",
                        "CLAVENAR_ASSURANCE_TLS_DIR",
                        "CLAVENAR_ASSURANCE_ALLOWED_CALLERS",
                        "CLAVENAR_ASSURANCE_FORENSIC_SUBJECT",
                        "CLAVENAR_ASSURANCE_FORENSIC_STREAM",
                        "CLAVENAR_ASSURANCE_REQUEST_TIMEOUT_SECS",
                        "CLAVENAR_ASSURANCE_RUN_TIMEOUT_SECS",
                        "CLAVENAR_ASSURANCE_PUBLISH_TIMEOUT_SECS",
                        "CLAVENAR_ASSURANCE_CERT_DIR",
                        "NATS_TLS_CERT_PATH",
                        "NATS_TLS_KEY_PATH",
                        "NATS_TLS_CA_PATH"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "tlsBundle": {
      "type": "object",
      "properties": {
        "secretName": { "type": "string" },
        "mountPath": { "type": "string" },
        "autoMint": { "type": "boolean" },
        "spiffeTrustDomain": { "const": "clavenar.local" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trustedProxy"],
          "properties": {
            "trustedProxy": {
              "$ref": "#/definitions/ledgerTrustedProxyPeerClass"
            }
          }
        },
        "console": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operatorMtls", "demo"],
          "properties": {
            "operatorMtls": { "$ref": "#/definitions/consolePeerClass" },
            "demo": { "$ref": "#/definitions/consolePeerClass" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "exec": {
                "properties": { "enabled": { "const": true } },
                "required": ["enabled"]
              }
            },
            "required": ["exec"]
          },
          {
            "properties": {
              "upstreamStub": {
                "properties": { "enabled": { "const": true } },
                "required": ["enabled"]
              }
            },
            "required": ["upstreamStub"]
          }
        ]
      },
      "then": {
        "properties": {
          "services": {
            "properties": {
              "proxy": {
                "properties": {
                  "extraEnv": {
                    "items": {
                      "properties": {
                        "name": {
                          "not": { "enum": ["CLAVENAR_UPSTREAM_URL"] }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deploymentProfile": { "const": "production" }
        },
        "required": ["deploymentProfile"]
      },
      "then": {
        "properties": {
          "authSecrets": {
            "properties": {
              "existingSecretName": { "type": "string", "minLength": 1 }
            },
            "required": ["existingSecretName", "rotationId"]
          },
          "tlsBundle": {
            "properties": {
              "secretName": { "type": "string", "minLength": 1 },
              "autoMint": { "const": false }
            },
            "required": ["secretName", "autoMint"]
          },
          "services": {
            "properties": {
              "ledger": {
                "properties": {
                  "enabled": { "const": true },
                  "trustedProxySpiffe": {
                    "const": "spiffe://clavenar.local/service/website"
                  },
                  "requireTrustedProxy": { "const": true }
                },
                "required": [
                  "enabled",
                  "trustedProxySpiffe",
                  "requireTrustedProxy"
                ]
              },
              "console": {
                "properties": {
                  "enabled": { "const": true },
                  "operatorMtls": {
                    "properties": {
                      "enabled": { "const": true },
                      "publicTrustSecretName": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["enabled", "publicTrustSecretName"]
                  }
                },
                "required": ["enabled", "operatorMtls"]
              }
            },
            "required": ["ledger", "console"]
          },
          "networkPolicy": {
            "properties": {
              "enabled": { "const": true },
              "ledger": {
                "properties": {
                  "trustedProxy": {
                    "properties": {
                      "allowedPeers": {
                        "minItems": 1,
                        "maxItems": 1
                      }
                    },
                    "required": ["allowedPeers"]
                  }
                },
                "required": ["trustedProxy"]
              }
            },
            "required": ["enabled", "ledger"]
          }
        },
        "required": ["authSecrets", "tlsBundle", "services", "networkPolicy"]
      }
    },
    {
      "if": {
        "properties": {
          "services": {
            "properties": {
              "console": {
                "properties": {
                  "operatorMtls": {
                    "properties": { "enabled": { "const": true } },
                    "required": ["enabled"]
                  }
                },
                "required": ["operatorMtls"]
              }
            },
            "required": ["console"]
          }
        },
        "required": ["services"]
      },
      "then": {
        "properties": {
          "tlsBundle": {
            "properties": {
              "secretName": { "type": "string", "minLength": 1 },
              "mountPath": { "const": "/certs" }
            },
            "required": ["secretName", "mountPath"]
          }
        },
        "required": ["tlsBundle"]
      }
    }
  ],
  "definitions": {
    "consolePeerClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedPeers"],
      "properties": {
        "allowedPeers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["podSelector"],
            "properties": {
              "podSelector": { "$ref": "#/definitions/exactPositiveSelector" },
              "namespaceSelector": { "$ref": "#/definitions/exactPositiveSelector" }
            }
          }
        }
      }
    },
    "ledgerTrustedProxyPeerClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedPeers"],
      "properties": {
        "allowedPeers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["podSelector", "namespaceSelector"],
            "properties": {
              "podSelector": {
                "$ref": "#/definitions/canonicalWebsitePodSelector"
              },
              "namespaceSelector": {
                "$ref": "#/definitions/externalWebsiteNamespaceSelector"
              }
            }
          }
        }
      }
    },
    "canonicalWebsitePodSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matchLabels"],
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "required": ["app.kubernetes.io/name"],
          "properties": {
            "app.kubernetes.io/name": { "const": "clavenar-website" }
          },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "externalWebsiteNamespaceSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matchLabels"],
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "required": ["kubernetes.io/metadata.name"],
          "properties": {
            "kubernetes.io/metadata.name": {
